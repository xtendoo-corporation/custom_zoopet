<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="zoopet_administration.account_invoice_form_inherit" model="ir.ui.view">
            <field name="name">account.invoice.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                 <xpath expr="//button[@name='action_invoice_sent']" position="replace">
                    <button name="action_invoice_sent"
                            type="object"
                            string="Enviar e Imprimir"
                            invisible="state != 'posted' or is_move_sent or move_type not in ('out_invoice', 'out_refund') or is_comercial"
                            class="oe_highlight"
                            groups="base.group_user"/>
                </xpath>

                <xpath expr="//button[@name='button_draft']" position="replace">
                    <field name="is_comercial" invisible="1"/>
                    <button name="button_draft"
                            string="Convertir a Borrador"
                            type="object"
                            groups="account.group_account_invoice"
                            invisible="state not in ('posted', 'cancel') or is_comercial"/>
                </xpath>

                <xpath expr="//button[@name='action_register_payment']" position="replace">
                    <field name="is_comercial" invisible="1"/>
                    <button name="action_register_payment"
                            id="account_invoice_payment_btn"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'posted' or payment_state not in ('not_paid', 'partial') or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or is_comercial"
                            string="Registrar Pago"
                            groups="account.group_account_invoice"/>
                </xpath>

                <xpath expr="//button[@name='action_reverse']" position="replace">
                    <field name="is_comercial" invisible="1"/>
                    <button name="action_reverse"
                            string="Agregar factura rectificativa"
                            type="object"
                            groups="account.group_account_invoice"
                            invisible="move_type not in ('out_invoice', 'in_invoice') or state != 'posted' or is_comercial"/>
                </xpath>

<!--                <xpath expr="//button[@name='action_duplicate']" position="replace">-->
<!--                    <button name="action_duplicate"-->
<!--                            string="Duplicar"-->
<!--                            type="object"-->
<!--                            groups="account.group_account_invoice"-->
<!--                            invisible="type != 'entry' or is_comercial"/>-->
<!--                </xpath>-->

                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="options">{"no_create": True}</attribute>
                </xpath>

                <xpath expr="//form//list/field[@name='product_id']" position="attributes">
                    <attribute name="options">{"no_create": True}</attribute>
                </xpath>

                <xpath expr="//form//list" position="attributes">
                    <attribute name="limit">800</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
