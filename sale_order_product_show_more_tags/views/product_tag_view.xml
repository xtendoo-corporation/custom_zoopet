<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--buscar mas... (ventas)-->

     <record model="ir.ui.view" id="product_template_tree_view_inherit">
        <field name="name"> product.template.tree.view.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='name']" position="after">
                <field name="tag_ids"  widget="many2many_tags"
                    options="{'color_field': 'color', 'no_create': True, 'no_create_edit': True}"
                />
            </xpath>
        </field>
    </record>
    <!-- Fin buscar mas... (ventas) -->

     <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.tags.line.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='name']" position="after">
                <field name="tag_ids"  widget="many2many_tags"
                    options="{'color_field': 'color', 'no_create': True, 'no_create_edit': True}"
                       optional="show"
                />
            </xpath>

        </field>
    </record>

     <record id="view_order_form_pvp" model="ir.ui.view">
        <field name="name">view.order.form.pvp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
           <xpath expr="//div[@name='pricing']//field[@name='list_price']" position="replace">
                <field name="list_price" invisible="1"/>
                <field name="lst_price" nolabel="1" class="oe_inline" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
