<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="document_format_zoopet.OrderReceipt"
        t-inherit="point_of_sale.OrderReceipt"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//t[@t-if='pos.company_logo_base64']" position="replace">
        </xpath>
        <xpath expr="//t[@t-if='!pos.company_logo_base64']" position="replace">
        </xpath>
        <xpath expr="//t[@t-if='receipt.cashier']" position="replace">
        </xpath>
         <xpath expr="//div[contains(text(), '--------------------------------')]" position="replace">
        </xpath>

    </t>
</templates>
